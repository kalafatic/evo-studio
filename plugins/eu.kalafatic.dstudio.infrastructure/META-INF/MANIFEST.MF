Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: EVO-Studio Infrastructure
Bundle-SymbolicName: eu.kalafatic.dstudio.infrastructure
Bundle-Version: 2.6.11.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-25
Automatic-Module-Name: eu.kalafatic.dstudio.infrastructure
Require-Bundle: eu.kalafatic.dstudio.core;bundle-version="2.6.11"
Import-Package: org.eclipse.jgit.api;version="[7.0.0,8.0.0)",
 org.eclipse.jgit.lib;version="[7.0.0,8.0.0)",
 org.eclipse.jgit.storage.file;version="[7.0.0,8.0.0)",
 org.eclipse.jgit.revwalk;version="[7.0.0,8.0.0)",
 org.eclipse.jgit.treewalk;version="[7.0.0,8.0.0)",
 org.eclipse.jgit.treewalk.filter;version="[7.0.0,8.0.0)",
 org.slf4j;version="[1.7.0,3.0.0)"
Bundle-ClassPath: .,
 lib/sqlite-jdbc.jar,
 lib/jackson-core-2.20.0.jar,
 lib/jackson-annotations-2.20.jar,
 lib/jackson-databind-2.20.0.jar
Export-Package: eu.kalafatic.dstudio.infrastructure.config,
 eu.kalafatic.dstudio.infrastructure.git,
 eu.kalafatic.dstudio.infrastructure.persistence,
 eu.kalafatic.dstudio.infrastructure.process,
 com.fasterxml.jackson.core,
 com.fasterxml.jackson.core.type,
 com.fasterxml.jackson.databind,
 com.fasterxml.jackson.databind.node,
 com.fasterxml.jackson.annotation
